# Confluent Cloud *Cloud resource management* API key (owned by a user/SA with
# OrganizationAdmin - needed to create the environment, gateway, service account).
# Copy to .env and fill in. .env is git-ignored.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# Optional overrides (defaults shown)
# DEMO_REGION=us-east-1
# DEMO_NAME=usm-demo
